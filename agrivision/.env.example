# ==============================================================================
# AgriFarm Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to:
#   agrivision/.envs/.production/.django
#   agrivision/.envs/.production/.postgres
# Do NOT commit production secrets to Git.
# ==============================================================================

# --- Django Production Settings ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DJANGO_ADMIN_URL=admin/
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-ec2-public-ip,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-ec2-public-ip,https://your-domain.com

# --- Security & SSL ---
# Set to True once SSL/TLS certificate is installed
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# --- Redis Cache ---
REDIS_URL=redis://redis:6379/0

# --- Database (PostgreSQL) ---
# For Option A (PostgreSQL in Docker Compose):
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=agrifarm_prod
POSTGRES_USER=agrifarm_user
POSTGRES_PASSWORD=choose-a-strong-database-password

# For Option B (Amazon RDS PostgreSQL):
# POSTGRES_HOST=agrifarm-db.xxxxxx.us-east-1.rds.amazonaws.com
# POSTGRES_PORT=5432
# POSTGRES_DB=agrifarm_prod
# POSTGRES_USER=agrifarm_admin
# POSTGRES_PASSWORD=your-rds-password
